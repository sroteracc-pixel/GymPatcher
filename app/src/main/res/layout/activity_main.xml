<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GymPatcher"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#e94560"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GymClass VR mod installer"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:padding="16dp"
            android:text="Loading..."
            android:textColor="#cccccc"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4"
            android:background="#0f3460"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnStep1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="STEP 1 — Save data &amp; remove GymClass"
            android:textColor="#ffffff"
            android:backgroundTint="#e94560"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStep2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="STEP 2 — Install modded GymClass"
            android:textColor="#ffffff"
            android:backgroundTint="#e94560"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStep3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="STEP 3 — Restore data &amp; open game"
            android:textColor="#ffffff"
            android:backgroundTint="#e94560"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnUninstall"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Uninstall GymClass completely"
            android:textColor="#ffffff"
            android:backgroundTint="#444444" />

    </LinearLayout>
</ScrollView>
